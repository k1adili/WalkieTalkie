<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFE8EAED"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Off"
                android:textColor="#FFB4BCC6"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/w_power"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Power"
            android:padding="9dp"
            android:src="@drawable/ic_widget_power" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_prev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Previous channel"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFE8EAED"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/w_channel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:gravity="center"
                android:text="CH 1"
                android:textColor="#FFFFB547"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Next channel"
                android:gravity="center"
                android:text="›"
                android:textColor="#FFE8EAED"
                android:textSize="26sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/w_talk"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/widget_talk_idle"
            android:contentDescription="Start talking"
            android:padding="16dp"
            android:src="@drawable/ic_widget_mic" />
    </LinearLayout>
</LinearLayout>
